#!/usr/bin/env python3
"""Launch from any directory using the configured Python and solver libraries."""
import json
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[1]
config = Path(os.getenv('TGPPO_PATHS', root / 'configs/paths.local.json')).resolve()
values = json.loads(config.read_text()) if config.is_file() else {}


def resolved(value):
    return str((config.parent / Path(value).expanduser()).resolve())


python = os.getenv('TGPPO_PYTHON') or (resolved(values['python']) if values.get('python') else sys.executable)
env = dict(os.environ)
env['TGPPO_PATHS'] = str(config)
paths = [str(root / 'src')]
if values.get('pyscipopt_import_dir'):
    paths.insert(0, resolved(values['pyscipopt_import_dir']))
env['PYTHONPATH'] = os.pathsep.join(paths)
prefix = env.get('TGPPO_SCIP_PREFIX') or values.get('scip_prefix') or env.get('SCIPOPTDIR')
if prefix:
    env['SCIPOPTDIR'] = env['TGPPO_SCIP_PREFIX'] = resolved(prefix)
    env['LD_LIBRARY_PATH'] = os.pathsep.join(filter(None, [
        str(Path(env['SCIPOPTDIR']) / 'lib'), env.get('LD_LIBRARY_PATH')]))
for name in ('OMP_NUM_THREADS', 'MKL_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):
    env[name] = '1'
env.update(PYTHONNOUSERSITE='1', PYTHONDONTWRITEBYTECODE='1', PYTHONUNBUFFERED='1',
           CUBLAS_WORKSPACE_CONFIG=':4096:8')
os.execvpe(python, [python, '-m', 'tgppo', *sys.argv[1:]], env)
